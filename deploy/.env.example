# Copy to .env and fill in. Never commit the filled-in copy.

# --- Domains ---------------------------------------------------------
APP_DOMAIN=etcrm.primafisoft.com
API_DOMAIN=api.primafisoft.com
ACME_EMAIL=contact@primafisoft.com

# Baked into the frontend bundle at BUILD time, not run time: changing it
# later needs `docker compose build frontend`, not a restart.
NEXT_PUBLIC_API_URL=https://api.primafisoft.com/api/v1

# --- Postgres --------------------------------------------------------
POSTGRES_USER=easyteam
POSTGRES_PASSWORD=                 # generate: openssl rand -base64 32
POSTGRES_DB=easyteam
