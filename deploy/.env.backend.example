# Everything `fly secrets list` holds, minus DATABASE_URL and DB_SSL, which
# docker-compose.yml sets for the compose network.
#
# Dump the current values on the old host, one at a time, with:
#   fly ssh console -a slackcrm-backend -C "printenv JWT_SECRET"
# `fly secrets list` shows only names and digests, never values.

# --- Identity --------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
PLATFORM_ADMIN_KEY=

# --- URLs: these CHANGE, they are not copied -------------------------
# Every one of them points at the old hosts today. Copying them verbatim is
# the single most likely way to break sign-in at cutover.
FRONTEND_URL=https://etcrm.primafisoft.com
APP_URL=https://etcrm.primafisoft.com
MOBILE_URL=
MOBILE_FRONTEND_URL=
GOOGLE_CALLBACK_URL=https://api.primafisoft.com/api/v1/auth/google/callback
OAUTH_GOOGLE_REDIRECT_URI=https://api.primafisoft.com/api/v1/oauth/google/callback
OAUTH_FACEBOOK_REDIRECT_URI=https://api.primafisoft.com/api/v1/oauth/facebook/callback
OAUTH_INSTAGRAM_REDIRECT_URI=https://api.primafisoft.com/api/v1/oauth/instagram/callback

# --- Google / Slack OAuth --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_SCOPES=
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=

# --- Meta / WhatsApp --------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Push -------------------------------------------------------------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
FIREBASE_SERVICE_ACCOUNT=

# --- Email ------------------------------------------------------------
EMAIL_PROVIDER=
FROM_EMAIL=
RESEND_API_KEY=

# --- Other ------------------------------------------------------------
TYPEFORM_API_KEY=
THROTTLE_LIMIT=
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=
