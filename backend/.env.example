# Database Configuration
# Option 1: Use DATABASE_URL (Neon, Supabase, or any PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option 2: Use individual connection parameters (local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=slackcrm

# Database Options
DB_SSL=false
DB_SYNC=false
DB_LOGGING=true

# Application Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:4001
MOBILE_FRONTEND_URL=easyteamcrm://
# Backward-compatible alias also accepted by backend
MOBILE_URL=easyteamcrm://
APP_URL=http://localhost:4000

# Stack Auth Configuration
NEXT_PUBLIC_STACK_PROJECT_ID=your_stack_project_id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your_stack_publishable_key
STACK_SECRET_SERVER_KEY=your_stack_secret_key

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-for-security
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# OAuth State Secret (REQUIRED - dedicated secret for OAuth CSRF protection)
# IMPORTANT: Never use the same secret as JWT_SECRET
# Generate a random 32+ character string for production
OAUTH_STATE_SECRET=your-oauth-state-secret-minimum-32-characters-long-different-from-jwt

# Encryption Key (REQUIRED - for encrypting sensitive data like OAuth tokens)
# MUST be exactly 64 hex characters (32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-character-hex-encryption-key-generate-with-openssl-rand-hex-32

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# Slack Configuration
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token

# OAuth Configuration
OAUTH_SLACK_CLIENT_ID=your-slack-oauth-client-id
OAUTH_SLACK_CLIENT_SECRET=your-slack-oauth-client-secret
OAUTH_SLACK_REDIRECT_URI=http://localhost:4000/api/v1/integrations/oauth/callback

OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/oauth/callback
OAUTH_GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/contacts.readonly,https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/drive.file

OAUTH_MICROSOFT_CLIENT_ID=your-microsoft-client-id
OAUTH_MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
OAUTH_MICROSOFT_REDIRECT_URI=http://localhost:4000/api/v1/integrations/oauth/callback
OAUTH_MICROSOFT_SCOPES=https://graph.microsoft.com/Mail.Read,https://graph.microsoft.com/Calendars.Read,https://graph.microsoft.com/Contacts.Read

OAUTH_HUBSPOT_CLIENT_ID=your-hubspot-client-id
OAUTH_HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
OAUTH_HUBSPOT_REDIRECT_URI=http://localhost:4000/api/v1/integrations/oauth/callback
OAUTH_HUBSPOT_SCOPES=crm.objects.contacts.read,crm.objects.contacts.write,crm.objects.deals.read,crm.objects.deals.write,crm.objects.companies.read

OAUTH_SALESFORCE_CLIENT_ID=your-salesforce-client-id
OAUTH_SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret
OAUTH_SALESFORCE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/oauth/callback
OAUTH_SALESFORCE_SCOPES=api,refresh_token

OAUTH_ZOOM_CLIENT_ID=your-zoom-client-id
OAUTH_ZOOM_CLIENT_SECRET=your-zoom-client-secret
OAUTH_ZOOM_REDIRECT_URI=http://localhost:4000/api/v1/integrations/oauth/callback
OAUTH_ZOOM_SCOPES=meeting:write,meeting:read,user:read

OAUTH_DOCUSIGN_CLIENT_ID=your-docusign-client-id
OAUTH_DOCUSIGN_CLIENT_SECRET=your-docusign-client-secret
OAUTH_DOCUSIGN_REDIRECT_URI=http://localhost:4000/api/v1/integrations/oauth/callback
OAUTH_DOCUSIGN_SCOPES=signature,impersonation

OAUTH_CALENDLY_CLIENT_ID=your-calendly-client-id
OAUTH_CALENDLY_CLIENT_SECRET=your-calendly-client-secret
OAUTH_CALENDLY_REDIRECT_URI=http://localhost:4000/api/v1/integrations/oauth/callback
OAUTH_CALENDLY_SCOPES=default

# AI Configuration
OPENAI_API_KEY=your-openai-api-key
CLAUDE_API_KEY=your-claude-api-key

# Email Configuration (SendGrid or SMTP)
# Option 1: SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# Option 2: SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SECURE=false

# Common Email Settings
FROM_EMAIL=noreply@yourcompany.com
FROM_NAME=Your Company Name

# External Integrations
TYPEFORM_API_KEY=your-typeform-api-key
ZOOM_API_KEY=your-zoom-api-key
ZOOM_API_SECRET=your-zoom-api-secret
MANYCHAT_API_TOKEN=your-manychat-api-token

# Redis Configuration (optional - for queues and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Cloudflare R2 object storage (optional)
# If all 5 are set, uploads go to R2 instead of local disk.
# Get these from Cloudflare dashboard -> R2 -> bucket + API token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://media.example.com
# Only needed for EU/jurisdiction buckets, e.g. https://<account>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
