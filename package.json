{
  "name": "slackcrm-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SlackCRM - AI-Powered Team CRM Platform",
  "workspaces": [
    "backend",
    "frontend",
    "ai-service",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:ai": "cd ai-service && npm run dev",
    "start": "npm run dev",
    "start:backend": "cd backend && npm run start:prod",
    "start:frontend": "cd frontend && npm run start",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build:shared": "cd shared && npm run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm run test",
    "test:frontend": "cd frontend && npm run test",
    "test:e2e": "cd backend && npm run test:e2e",
    "test:cov": "cd backend && npm run test:cov",
    "test:watch": "cd backend && npm run test:watch",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:fix": "npm run lint:fix:backend && npm run lint:fix:frontend",
    "lint:fix:backend": "cd backend && npm run lint --fix",
    "lint:fix:frontend": "cd frontend && npm run lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "cd backend && npm run typecheck",
    "typecheck:frontend": "cd frontend && npm run typecheck",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "migration:generate": "cd backend && npm run migration:generate",
    "migration:run": "cd backend && npm run migration:run",
    "migration:revert": "cd backend && npm run migration:revert",
    "migration:show": "cd backend && npm run migration:show",
    "db:seed": "node scripts/seed-database.js",
    "db:reset": "npm run migration:revert && npm run migration:run && npm run db:seed",
    "validate": "npm run validate:env && npm run validate:production",
    "validate:env": "node scripts/env-validator.js",
    "validate:production": "bash scripts/validate-production.sh",
    "test:workflow": "bash scripts/test-workflow.sh",
    "health": "curl -s http://localhost:4000/api/v1/health/readiness | json_pp",
    "clean": "rm -rf backend/dist backend/node_modules frontend/.next frontend/node_modules node_modules",
    "clean:build": "rm -rf backend/dist frontend/.next",
    "fresh": "npm run clean && npm install && npm run build",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\""
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.9",
    "pg": "^8.17.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
